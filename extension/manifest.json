{
  "manifest_version": 3,
  "name": "Canvas Quiz Assistant",
  "version": "1.0",
  "description": "Subtle, slide-grounded AI assistant for Canvas quizzes.",
  "permissions": ["activeTab"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/*",
        "https://canvas.skku.edu/*",
        "https://canvas.uts.edu.au/*",
        "*://*/*quiz*",
        "file:///*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}